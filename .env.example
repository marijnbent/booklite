PORT=6060
APP_DATA_DIR=/app/data
BOOKS_DIR=/books
BASE_URL=http://localhost:6060
# Required: set this to a long random secret before starting BookLite
JWT_SECRET=
APP_DATA_BIND=./app-data
BOOKS_BIND=./books
BOOKLITE_FRONTEND_MODE=auto
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=7776000
# Optional
# AMAZON_BOOKS_DOMAIN=com
# AMAZON_BOOKS_COOKIE=
# GOOGLE_BOOKS_LANGUAGE=
# GOOGLE_BOOKS_API_KEY=
# HARDCOVER_API_KEY=
# OpenRouter credentials are read from the environment and are never stored in BookLite.
# OPENROUTER_API_KEY=
# Single sign-on through an OpenID Connect provider. Set all three or none.
# Redirect URI to register at the provider: <BASE_URL>/api/v1/auth/oidc/callback
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# BOOTSTRAP_OWNER_EMAIL=owner@example.com
# BOOTSTRAP_OWNER_USERNAME=owner
# BOOTSTRAP_OWNER_PASSWORD=change-me
